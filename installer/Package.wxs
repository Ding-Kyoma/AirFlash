<?xml version="1.0" encoding="utf-8"?>
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui"
     xmlns:util="http://wixtoolset.org/schemas/v4/wxs/util">
  <Package Name="AirFlash"
           Manufacturer="AirFlash"
           Version="$(var.ProductVersion)"
           UpgradeCode="{E9C2A5B0-6A5F-4D4C-9B9F-8F3E1A56A1D3}"
           Scope="perMachine"
           Compressed="yes">
    <SummaryInformation Description="Windows system audio to AirFlash receivers"/>
    <MajorUpgrade Schedule="afterInstallInitialize" DowngradeErrorMessage="A newer version of AirFlash is already installed."/>
    <MediaTemplate EmbedCab="yes"/>
    <util:CloseApplication Id="CloseRunningApplication"
                           Target="AirFlash.exe"
                           CloseMessage="yes"
                           EndSessionMessage="yes"
                           Timeout="10"
                           Property="AIRFLASH_STILL_RUNNING"
                           RebootPrompt="no"/>
    <CustomAction Id="RequireAirFlashExited"
                  Error="AirFlash could not exit. Close AirFlash, then retry installation or removal."/>
    <InstallExecuteSequence>
      <Custom Action="override Wix4CloseApplications_X64" Before="RequireAirFlashExited"/>
      <Custom Action="RequireAirFlashExited" Before="InstallValidate" Condition="AIRFLASH_STILL_RUNNING"/>
    </InstallExecuteSequence>
    <SetProperty Id="REINSTALLMODE" Value="amus" Before="CostInitialize" Sequence="both"/>
    <SetProperty Id="ARPINSTALLLOCATION" Value="[INSTALLFOLDER]" After="CostFinalize" Sequence="execute"/>

    <Icon Id="ApplicationIcon" SourceFile="$(var.AppIcon)"/>
    <Property Id="ARPPRODUCTICON" Value="ApplicationIcon"/>
    <WixVariable Id="WixUILicenseRtf" Value="$(var.UiLicenseFile)"/>
    <ui:WixUI Id="WixUI_FeatureTree"/>

    <Launch Condition="VersionNT64" Message="Windows 10 or later on a 64-bit system is required."/>

    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="AirFlash"/>
    </StandardDirectory>

    <StandardDirectory Id="ProgramMenuFolder">
      <Directory Id="AirFlashProgramsFolder" Name="AirFlash"/>
    </StandardDirectory>

    <DirectoryRef Id="INSTALLFOLDER">
      <Component Id="ApplicationComponent" Guid="{B5DB5EE1-5BF1-48ED-AF69-1324D9DE4A09}">
        <RemoveFile Id="ReplaceApplicationExe" Name="AirFlash.exe" On="install"/>
        <RemoveFolder Id="RemoveInstallFolder" On="uninstall"/>
        <File Id="ApplicationExe"
              Source="$(var.AppExe)"
              KeyPath="yes"
              Checksum="yes"/>
      </Component>
    </DirectoryRef>

    <StandardDirectory Id="DesktopFolder">
      <Component Id="DesktopShortcutComponent" Guid="{A4F96A74-C925-4BB9-8C80-7A4BA9AE2024}">
        <Shortcut Id="DesktopShortcut"
                  Name="AirFlash"
                  Description="Send Windows system audio to an AirFlash receiver"
                  Target="[INSTALLFOLDER]AirFlash.exe"
                  WorkingDirectory="INSTALLFOLDER"/>
        <RegistryValue Root="HKCU"
                       Key="Software\AirFlash"
                       Name="DesktopShortcut"
                       Type="integer"
                       Value="1"
                       KeyPath="yes"/>
      </Component>
    </StandardDirectory>

    <DirectoryRef Id="AirFlashProgramsFolder">
      <Component Id="StartMenuShortcutComponent" Guid="{6BDBB7C5-9207-44C5-9A8A-C8B5544D6F8A}">
        <Shortcut Id="StartMenuShortcut"
                  Name="AirFlash"
                  Description="Send Windows system audio to an AirFlash receiver"
                  Target="[INSTALLFOLDER]AirFlash.exe"
                  WorkingDirectory="INSTALLFOLDER"/>
        <RemoveFolder Id="RemoveStartMenuFolder" On="uninstall"/>
        <RegistryValue Root="HKCU"
                       Key="Software\AirFlash"
                       Name="StartMenuShortcut"
                       Type="integer"
                       Value="1"
                       KeyPath="yes"/>
      </Component>
    </DirectoryRef>

    <Feature Id="MainFeature"
             Title="AirFlash"
             Description="AirFlash application"
             Level="1"
             AllowAbsent="no"
             ConfigurableDirectory="INSTALLFOLDER">
      <ComponentRef Id="ApplicationComponent"/>
      <Feature Id="DesktopShortcutFeature"
               Title="Desktop shortcut"
               Description="Create an AirFlash shortcut on the desktop"
               Level="1"
               AllowAbsent="yes"
               InstallDefault="local">
        <ComponentRef Id="DesktopShortcutComponent"/>
      </Feature>
      <Feature Id="StartMenuShortcutFeature"
               Title="Start menu shortcut"
               Description="Create an AirFlash shortcut in the Start menu"
               Level="1"
               AllowAbsent="yes"
               InstallDefault="local">
        <ComponentRef Id="StartMenuShortcutComponent"/>
      </Feature>
    </Feature>
  </Package>
</Wix>
